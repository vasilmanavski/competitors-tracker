{
  "name": "competitorpulse-api",
  "version": "1.0.0",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migration": "drizzle-kit generate --custom",
    "test": "node --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:db": "createdb competitorpulse_test 2>/dev/null || true"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
