# Local (non-Docker) development. Copy to api/.env — `npm run dev` loads it.
# In Docker these values come from docker-compose.yml instead.
PORT=3000
DATABASE_URL=postgres://localhost:5432/competitorpulse
SOURCE_BASE_URL=http://localhost:4002
LLM_BASE_URL=http://localhost:4001/v1
LLM_API_KEY=not-needed-for-mock
LLM_MODEL=mock-model
LLM_DAILY_CAP=2000
# 900 = the brief's 15 min. Use e.g. 30 locally to watch the timeline fill up.
POLL_INTERVAL_SECONDS=900
SOURCE_RATE_LIMIT_PER_SECOND=4
SOURCE_TIMEOUT_MS=5000
SOURCE_MAX_RETRIES=2
