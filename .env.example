# Optional overrides for docker compose. Copy to .env and edit.
# Point the API at a different listing source or LLM:
# SOURCE_BASE_URL=http://host.docker.internal:5002
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_DAILY_CAP=2000
# LLM_TIMEOUT_MS=10000
# POLL_INTERVAL_SECONDS=900
# SOURCE_RATE_LIMIT_PER_SECOND=4   # our pace for all source requests (source allows 5/s)
# SOURCE_TIMEOUT_MS=5000
# SOURCE_MAX_RETRIES=2
